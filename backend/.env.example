# Configurações do Servidor
PORT=8000
HOST=0.0.0.0
ALLOWED_DOMAIN=ufg.br

# Chave API do Google Gemini (para extração multimodal de chats e prints)
GEMINI_API_KEY=sua_chave_gemini_api_aqui

# Autenticação Google OAuth 2.0 Client ID (Frontend/Backend validation)
GOOGLE_CLIENT_ID=seu_client_id_google_oauth.apps.googleusercontent.com

# ID da Planilha do Google Sheets (FNDE)
# https://docs.google.com/spreadsheets/d/1lQyVlaZOyem8F7SaaeRSpgx1JOTQVRzg7XawseG3TgQ/edit
GOOGLE_SPREADSHEET_ID=1lQyVlaZOyem8F7SaaeRSpgx1JOTQVRzg7XawseG3TgQ

# Caminho ou JSON da Service Account com permissão na planilha
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
